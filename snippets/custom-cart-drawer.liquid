
<div id="custom-cart-drawer">
  <!-- Cart Button -->
  <button type="button" class="ccd-open" data-cart-drawer-open>
    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 3h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L21 8H6"/>
      <circle cx="10" cy="20" r="1"/>
      <circle cx="18" cy="20" r="1"/>
    </svg>
    <span>Cart</span>
    <span class="ccd-count">{{ cart.item_count }}</span>
  </button>

  <!-- Overlay -->
  <div class="ccd-overlay" data-ccd-overlay></div>

  <!-- Cart Drawer -->
  <aside class="ccd-drawer" data-ccd-drawer aria-label="Shopping cart">
    <div class="ccd-header">
      <div>
        <h2>Your Cart</h2>
        <p>{{ cart.item_count }} items in your cart</p>
      </div>

      <button type="button" class="ccd-close" data-cart-drawer-close aria-label="Close cart">
        &times;
      </button>
    </div>

    <!-- Cart Items -->
    <div class="ccd-body">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="ccd-item">
            <a href="{{ item.url }}" class="ccd-image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | default: item.product.title | escape }}"
                  width="100"
                  height="120"
                >
              {% endif %}
            </a>

            <div class="ccd-details">
              <a href="{{ item.url }}" class="ccd-title">
                {{ item.product.title | escape }}
              </a>

            {% if item.product.has_only_default_variant == false %}
  <p class="ccd-variant">{{ item.variant.title | escape }}</p>
{% endif %}

              <p class="ccd-price">{{ item.final_price | money }}</p>
              <p class="ccd-quantity">Qty: {{ item.quantity }}</p>

              <a
                href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                class="ccd-remove" data-cart-remove data-line="{{ forloop.index }}"
              >
                Remove
              </a>
            </div>

           
          </div>
        {% endfor %}
      {% else %}
        <div class="ccd-empty">
          <div class="ccd-empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H5"/>
            </svg>
          </div>

          <h3>Your cart is empty</h3>
          <p>Looks like you haven't added anything yet.</p>

          <a href="{{ routes.all_products_collection_url }}" class="ccd-continue">
            Continue shopping
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Cart Footer -->
    {% if cart.item_count > 0 %}
      <div class="ccd-footer">
        <div class="ccd-subtotal">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>

        <p class="ccd-note">Taxes and shipping are calculated at checkout.</p>

        <a href="{{ routes.cart_url }}" class="ccd-view-cart">View cart</a>

        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="ccd-checkout">
            Proceed to checkout
            <span aria-hidden="true">&rarr;</span>
          </button>
        </form>
      </div>
    {% endif %}
  </aside>
</div>

<style>
  #custom-cart-drawer {
    font-family: inherit;
    color: #222;
  }

  #custom-cart-drawer * {
    box-sizing: border-box;
  }

  /* Cart Button */
  #custom-cart-drawer .ccd-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 11px 16px;
    border: 1px solid #222;
    background: #222;
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  #custom-cart-drawer .ccd-open:hover {
    background: #fff;
    color: #222;
  }

  #custom-cart-drawer .ccd-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    font-size: 11px;
  }

  #custom-cart-drawer .ccd-open:hover .ccd-count {
    background: #eee;
  }

  /* Overlay */
  #custom-cart-drawer .ccd-overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  #custom-cart-drawer .ccd-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Drawer */
  #custom-cart-drawer .ccd-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    width: min(440px, 100%);
    height: 100vh;
    height: 100dvh;
    background: #fff;
    color: #222;
    box-shadow: -8px 0 30px rgba(0, 0, 0, 0.1);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0.3s ease;
  }

  #custom-cart-drawer .ccd-drawer.active {
    transform: translateX(0);
    visibility: visible;
  }

  /* Header */
  #custom-cart-drawer .ccd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 24px;
    border-bottom: 1px solid #eee;
  }

  #custom-cart-drawer .ccd-header h2 {
    margin: 0;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
  }

  #custom-cart-drawer .ccd-header p {
    margin: 5px 0 0;
    color: #777;
    font-size: 12px;
  }

  #custom-cart-drawer .ccd-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid #e5e5e5;
    border-radius: 50%;
    background: #fff;
    color: #222;
    font-size: 25px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #custom-cart-drawer .ccd-close:hover {
    background: #f5f5f5;
  }

  /* Cart Items */
  #custom-cart-drawer .ccd-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 24px;
  }

  #custom-cart-drawer .ccd-item {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 14px;
    padding: 22px 0;
    border-bottom: 1px solid #eee;
  }

  #custom-cart-drawer .ccd-image {
    display: block;
    width: 100px;
    height: 100px;
    overflow: hidden;
    border-radius: 3px;
    background: #f6f6f6;
  }

  #custom-cart-drawer .ccd-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #custom-cart-drawer .ccd-details {
    min-width: 0;
  }

  #custom-cart-drawer .ccd-title {
    color: #222;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }

  #custom-cart-drawer .ccd-title:hover {
    text-decoration: underline;
  }

  #custom-cart-drawer .ccd-variant,
  #custom-cart-drawer .ccd-quantity {
    margin: 6px 0;
    color: #777;
    font-size: 12px;
  }

  #custom-cart-drawer .ccd-price {
    margin: 8px 0;
    font-size: 13px;
  }

  #custom-cart-drawer .ccd-remove {
    display: inline-block;
    margin-top: 4px;
    color: red;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

   #custom-cart-drawer .ccd-remove:hover{
    color: #666;
   }

  #custom-cart-drawer .ccd-remove.loading {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    opacity: 0.6;
    pointer-events: none;
    text-decoration: none;
  }

  #custom-cart-drawer .ccd-remove.loading::after {
    content: "";
    width: 10px;
    height: 10px;
    border: 1.5px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: ccd-spin 0.6s linear infinite;
  }

  @keyframes ccd-spin {
    to {
      transform: rotate(360deg);
    }
  }



  /* Empty Cart */
  #custom-cart-drawer .ccd-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 65px 10px;
    text-align: center;
  }

  #custom-cart-drawer .ccd-empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    border: 1px solid #e8e8e8;
    border-radius: 50%;
    color: #444;
  }

  #custom-cart-drawer .ccd-empty h3 {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 600;
  }

  #custom-cart-drawer .ccd-empty p {
    margin: 0 0 24px;
    color: #777;
    font-size: 13px;
    line-height: 1.6;
  }

  /* Continue Shopping Button */
  #custom-cart-drawer .ccd-continue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 46px;
    padding: 12px 20px;
    border: 1px solid #222;
    border-radius: 4px;
    background: #222;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  #custom-cart-drawer .ccd-continue:hover {
    background: #fff;
    color: #222;
  }

  /* Footer */
  #custom-cart-drawer .ccd-footer {
    padding: 22px 24px;
    border-top: 1px solid #eee;
    background: #fff;
  }

  #custom-cart-drawer .ccd-subtotal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }

  #custom-cart-drawer .ccd-subtotal strong {
    font-size: 16px;
    font-weight: 600;
  }

  #custom-cart-drawer .ccd-note {
    margin: 9px 0 18px;
    color: #777;
    font-size: 11px;
    line-height: 1.5;
  }

  #custom-cart-drawer .ccd-view-cart,
  #custom-cart-drawer .ccd-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 46px;
    padding: 12px 16px;
    border: 1px solid #222;
    border-radius: 4px;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  #custom-cart-drawer .ccd-view-cart {
    margin-bottom: 10px;
    background: #fff;
    color: #222;
  }

  #custom-cart-drawer .ccd-view-cart:hover {
    background: #f5f5f5;
  }

  #custom-cart-drawer .ccd-checkout {
    background: #222;
    color: #fff;
  }

  #custom-cart-drawer .ccd-checkout:hover {
    background: #fff;
    color: #222;
  }

  @media (max-width: 480px) {
    #custom-cart-drawer .ccd-header {
      padding: 18px;
    }

    #custom-cart-drawer .ccd-body {
      padding: 0 18px;
    }

    #custom-cart-drawer .ccd-footer {
      padding: 18px;
    }
  }
</style>

<script>
  const openCartButton = document.querySelector(
    "#custom-cart-drawer [data-cart-drawer-open]"
  );

  const closeCartButton = document.querySelector(
    "#custom-cart-drawer [data-cart-drawer-close]"
  );

  const cartDrawer = document.querySelector(
    "#custom-cart-drawer [data-ccd-drawer]"
  );

  const cartOverlay = document.querySelector(
    "#custom-cart-drawer [data-ccd-overlay]"
  );

  openCartButton.addEventListener("click", function () {
    cartDrawer.classList.add("active");
    cartOverlay.classList.add("active");
  });

  closeCartButton.addEventListener("click", function () {
    cartDrawer.classList.remove("active");
    cartOverlay.classList.remove("active");
  });

  cartOverlay.addEventListener("click", function () {
    cartDrawer.classList.remove("active");
    cartOverlay.classList.remove("active");
  });
</script>
