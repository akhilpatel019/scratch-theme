{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'base.css' | asset_url | stylesheet_tag }}

{% style  %} 

.custom-header-wrapper {
    max-width: {{ section.settings.header-max-width }}px;
}

{% endstyle %}

<header class="custom-header">

<div class="custom-header-wrapper">
  <!-- Left on Mobile: Hamburger Menu Toggle -->
  <div class="custom-header__toggle-wrap">
    <button
      type="button"
      class="custom-header__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      data-mobile-menu-open
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Center on Mobile / Left on Desktop: Logo -->
  <div class="custom-header__logo">
    <a href="/" aria-label="Home">

    {%if settings.store_logo != blank%}

        <img src="{{settings.store_logo |  image_url: width: 150}}" alt="{{shop.name}}">

        {% else %}
      <img
        src="https://placehold.co/160x50?text=YOUR+LOGO"
        alt="Store logo"
        width="160"
        height="50"
      >

    {% endif %}
    </a>
  </div>

  <!-- Center on Desktop: Navigation (Hidden on Mobile) -->
  <nav class="custom-header__nav" aria-label="Main navigation">
<ul class="custom-header__menu">
  {% for link in section.settings.header_menu.links %}
    {% if link.title == 'Collection' %}
      <li class="custom-header__mega-item">
        <a href="{{ link.url }}" class="custom-header__mega-trigger">
          {{ link.title }}
          <span class="custom-header__chevron"></span>
        </a>

        <div class="custom-header__mega-menu">
          <!-- First Collection List -->
          <div class="custom-header__mega-column">
            <h3>Shop by Category</h3>
            <a href="/collections/all">All Products</a>
            <a href="/collections/new-arrivals">New Arrivals</a>
            <a href="/collections/best-sellers">Best Sellers</a>
          </div>

          <!-- Second Collection List -->
          <div class="custom-header__mega-column">
            <h3>Featured Collections</h3>
            <a href="/collections/featured">Featured Products</a>
            <a href="/collections/sale">Sale</a>
            <a href="/collections/popular">Popular Products</a>
          </div>

          <!-- Featured Image -->
          <div class="custom-header__mega-image">
            <a href="/collections/all">

            {% if section.settings.mega_menu_img != blank %}
                <img
                src="{{section.settings.mega_menu_img |  image_url: width:500}}"
                alt="Featured collection"
                width="500"
                height="320"
                loading="lazy"
              >

              {% else %}
              <img
                src="https://placehold.co/500x320?text=Featured+Collection"
                alt="Featured collection"
                width="500"
                height="320"
                loading="lazy"
              >
            {% endif %}
            </a>

            <p>Discover Our Collection</p>
            <a class="custom-header__mega-cta" href="/collections/all">
              Explore Now →
            </a>
          </div>
        </div>
      </li>
    {% else %}
      <li>
        <a href="{{ link.url }}">{{ link.title }}</a>
      </li>
    {% endif %}
  {% endfor %}
</ul>
  </nav>

  <!-- Right: Cart and Account -->
  <div class="custom-header__actions">

    <!-- Existing cart snippet: no additional styling applied -->
    {% render 'custom-cart-drawer' %}

    <!-- User Icon -->
    <a
      class="custom-header__account"
      href="{{ routes.account_url }}"
      aria-label="My account"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="23"
        height="23"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M5 21v-2a7 7 0 0 1 14 0v2"></path>
      </svg>
    </a>

  </div>
</div>

<!-- Mobile Menu Overlay -->
<div class="custom-header__mobile-overlay" data-mobile-menu-overlay></div>

<!-- Mobile Menu Drawer (Uses exact same data as desktop) -->
<aside class="custom-header__mobile-drawer" data-mobile-menu-drawer aria-label="Mobile navigation">
  <div class="custom-header__mobile-header">
    <span class="custom-header__mobile-title">Menu</span>
    <button
      type="button"
      class="custom-header__mobile-close"
      aria-label="Close menu"
      data-mobile-menu-close
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="custom-header__mobile-body">
    <ul class="custom-header__mobile-menu">
      {% for link in section.settings.header_menu.links %}
        {% if link.title == 'Collection' %}
          <li class="custom-header__mobile-item custom-header__mobile-accordion" data-accordion>
            <button
              type="button"
              class="custom-header__mobile-link custom-header__mobile-accordion-trigger"
              data-accordion-trigger
              aria-expanded="false"
            >
              <span>{{ link.title }}</span>
              <span class="custom-header__mobile-chevron"></span>
            </button>

            <div class="custom-header__mobile-accordion-content" data-accordion-content>
              <!-- First Collection List -->
              <div class="custom-header__mobile-subgroup">
                <span class="custom-header__mobile-subtitle">Shop by Category</span>
                <a href="/collections/all">All Products</a>
                <a href="/collections/new-arrivals">New Arrivals</a>
                <a href="/collections/best-sellers">Best Sellers</a>
              </div>

              <!-- Second Collection List -->
              <div class="custom-header__mobile-subgroup">
                <span class="custom-header__mobile-subtitle">Featured Collections</span>
                <a href="/collections/featured">Featured Products</a>
                <a href="/collections/sale">Sale</a>
                <a href="/collections/popular">Popular Products</a>
              </div>

              <!-- Featured Image / Promo -->
              <div class="custom-header__mobile-promo">
                <a href="/collections/all" class="custom-header__mobile-promo-card">
                  {% if section.settings.mega_menu_img != blank %}
                    <img
                      src="{{ section.settings.mega_menu_img | image_url: width: 500 }}"
                      alt="Featured collection"
                      width="500"
                      height="320"
                      loading="lazy"
                    >
                  {% else %}
                    <img
                      src="https://placehold.co/500x320?text=Featured+Collection"
                      alt="Featured collection"
                      width="500"
                      height="320"
                      loading="lazy"
                    >
                  {% endif %}
                  <div class="custom-header__mobile-promo-info">
                    <p>Discover Our Collection</p>
                    <span class="custom-header__mobile-promo-cta">Explore Now &rarr;</span>
                  </div>
                </a>
              </div>
            </div>
          </li>
        {% else %}
          <li class="custom-header__mobile-item">
            <a href="{{ link.url }}" class="custom-header__mobile-link">{{ link.title }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <div class="custom-header__mobile-footer">
    <a href="{{ routes.account_url }}" class="custom-header__mobile-account">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M5 21v-2a7 7 0 0 1 14 0v2"></path>
      </svg>
      <span>My Account</span>
    </a>
  </div>
</aside>

</header>

<script>
  (function() {
    function initCustomHeader() {
      const header = document.querySelector('.custom-header');
      if (!header || header.dataset.mobileInitialized === 'true') return;
      header.dataset.mobileInitialized = 'true';

      const toggleBtn = header.querySelector('[data-mobile-menu-open]');
      const closeBtn = header.querySelector('[data-mobile-menu-close]');
      const drawer = header.querySelector('[data-mobile-menu-drawer]');
      const overlay = header.querySelector('[data-mobile-menu-overlay]');

      function openMobileMenu() {
        if (drawer && overlay) {
          drawer.classList.add('active');
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        }
      }

      function closeMobileMenu() {
        if (drawer && overlay) {
          drawer.classList.remove('active');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        }
      }

      if (toggleBtn) toggleBtn.addEventListener('click', openMobileMenu);
      if (closeBtn) closeBtn.addEventListener('click', closeMobileMenu);
      if (overlay) overlay.addEventListener('click', closeMobileMenu);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawer && drawer.classList.contains('active')) {
          closeMobileMenu();
        }
      });

      const accordionTriggers = header.querySelectorAll('[data-accordion-trigger]');
      accordionTriggers.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          const item = trigger.closest('[data-accordion]');
          if (!item) return;
          const isOpen = item.classList.contains('active');
          item.classList.toggle('active');
          trigger.setAttribute('aria-expanded', !isOpen);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCustomHeader);
    } else {
      initCustomHeader();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        const header = document.querySelector('.custom-header');
        if (header) header.dataset.mobileInitialized = 'false';
        initCustomHeader();
      }
    });
  })();
</script>



{% schema  %} 
{
    "name": "Header",
    "limit": 1,
    "settings": [
        {
            "type": "header",
            "content": "Header Settings"
        },
                        {
                "type": "link_list",
                "id": "header_menu",
                "label": "Select Menu"
                },
                {
                    "type": "image_picker",
                    "id": "mega_menu_img",
                    "label": "Mega Menu Image"
                },
                {
                    "type": "range",
                    "id": "header-max-width",
                    "label": "Set Header Max Width",
                    "max": 1400,
                    "min": 1200,
                    "step": 100,
                    "default": 1300
                }
    ],
    "blocks": [],
    "presets": [
        {
            "name": "Header"
        }
    ]
}
{% endschema %}

