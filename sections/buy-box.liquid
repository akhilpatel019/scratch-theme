{% comment %}
  Simple Buy Box
  Hardcoded demo content with a Swiper thumbnail gallery.
  Replace the variant ID before testing cart functionality.
{% endcomment %}

{{ 'buy-box.css' | asset_url | stylesheet_tag }}
{{ 'base.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
>

<section id="simple-buy-box-{{ section.id }}" class="simple-buy-box page_width">
  <!-- LEFT: IMAGE GALLERY -->
  <div class="simple-gallery">
    <div class="swiper simple-main-slider">
      <div class="swiper-wrapper">
        {% for product_main_img in product.images %}
          <div class="swiper-slide">
            <img
              src="{{ product_main_img | image_url: width: 600 }}"
              alt="{{ product_main_img.alt | default: product.title | escape }}"
              width="1000"
              height="1000"
              {% if forloop.first %}
                fetchpriority="high"
              {% endif %}
            >
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Thumbnails -->
    <div class="swiper simple-thumb-slider">
      <div class="swiper-wrapper">
        {% for product_thumbs in product.media %}
          {% if product_thumbs.media_type == 'image' %}
            <div class="swiper-slide">
              <img
                src="{{ product_thumbs | image_url: width: 200 }}"
                alt="{{ product_thumbs.alt | default: product.title | escape }}"
                width="220"
                height="220"
                loading="lazy"
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- RIGHT: PRODUCT DETAILS -->
  <div class="simple-product-info">
    {% assign product_var = product %}

    <h1>{{ product_var.title }}</h1>

    <div class="simple-product-description">
      {{ product_var.description }}
    </div>

    <div class="simple-product-price">{{ product_var.price | money }}</div>

    <form action="{{ routes.cart_add_url }}" method="post" class="simple-product-form">
      <!-- Replace with a real variant ID from your store -->
      <input type="hidden" name="id" value="{{product_var.selected_or_first_available_variant.id}}">

    
{% for block in section.blocks %}
  {% case block.type %}
    {% when 'quantity-selector' %}
      {% render 'quantity-selector', block: block %}
  {% endcase %}
{% endfor %}


      <div class="simple-buy-buttons">
        <button type="submit" class="simple-add-button">Add to cart</button>

        <button
          type="submit"
          class="simple-buy-now-button"
          formaction="{{ routes.cart_add_url }}?return_to=/checkout"
        >
          Buy it now
        </button>
      </div>

      
    </form>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script>
  (() => {
    const sectionId = 'simple-buy-box-{{ section.id }}';

    function initSimpleBuyBox() {
      const section = document.getElementById(sectionId);

      if (!section || section.dataset.swiperInitialized === 'true') return;

      if (typeof Swiper === 'undefined') {
        setTimeout(initSimpleBuyBox, 150);
        return;
      }

      const mainElement = section.querySelector('.simple-main-slider');
      const thumbElement = section.querySelector('.simple-thumb-slider');

      if (!mainElement || !thumbElement) return;

      section.dataset.swiperInitialized = 'true';

      const thumbSwiper = new Swiper(thumbElement, {
        slidesPerView: 'auto',
        spaceBetween: 10,
        watchSlidesProgress: true,
        slideToClickedSlide: true,
        observer: true,
        observeParents: true,
      });

      new Swiper(mainElement, {
        slidesPerView: 1,
        spaceBetween: 0,
        observer: true,
        observeParents: true,
        thumbs: {
          swiper: thumbSwiper,
        },
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSimpleBuyBox);
    } else {
      initSimpleBuyBox();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        const section = document.getElementById(sectionId);
        if (section) section.dataset.swiperInitialized = 'false';
        initSimpleBuyBox();
      }
    });
  })();


  

document.querySelectorAll(".simple-product-form").forEach(function (form) {
  if (form.dataset.ajaxInitialized === "true") return;
  form.dataset.ajaxInitialized = "true";

  form.addEventListener("submit", async function (event) {
    // Keep Buy Now's normal checkout behavior
    if (event.submitter?.classList.contains("simple-buy-now-button")) {
      return;
    }

    event.preventDefault();

    const addButton = form.querySelector(".simple-add-button");
    if (addButton) addButton.disabled = true;

    try {
      const formData = new FormData(form);

      const response = await fetch(
        `${window.Shopify.routes.root}cart/add.js`,
        {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json"
          }
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.description || data.message || "Could not add product.");
      }

      // Request freshly rendered cart drawer HTML
      const sectionResponse = await fetch(
        `${window.Shopify.routes.root}?sections=custom-cart-drawer-section`
      );

      if (!sectionResponse.ok) {
        throw new Error("Could not refresh the cart drawer.");
      }

      const sections = await sectionResponse.json();
      const updatedHTML = sections["custom-cart-drawer-section"];

      if (!updatedHTML) {
        throw new Error("The cart drawer section returned no HTML.");
      }

      const parser = new DOMParser();
      const newDocument = parser.parseFromString(updatedHTML, "text/html");

      const currentDrawer = document.querySelector("[data-ccd-drawer]");
      const newDrawer = newDocument.querySelector("[data-ccd-drawer]");

      if (!currentDrawer || !newDrawer) {
        throw new Error("Could not find the cart drawer in the updated HTML.");
      }

      // Replace the drawer's content with the fresh Liquid-rendered content
      currentDrawer.innerHTML = newDrawer.innerHTML;

      // Open the drawer
      currentDrawer.classList.add("active");

      const overlay = document.querySelector("[data-ccd-overlay]");
      if (overlay) overlay.classList.add("active");

    } catch (error) {
      console.error("Cart error:", error);
    } finally {
      if (addButton) addButton.disabled = false;
    }
  });
});







</script>

{% schema %}
{
  "name": "Simple Buy Box",
  "settings": [],
  "blocks": [
    {
      "type": "quantity-selector",
      "limit": 1,
      "name": "Quantity Selector"
    }
  ],
  "presets": [
    {
      "name": "Simple Buy Box"
    }
  ]
}
{% endschema %}
