<section class="featured-collection page_width">
  <div class="collection-header">
    <div>
      <p class="collection-subtitle">{{section.settings.section_label}}</p>
      <h2>{{section.settings.section_title}}</h2>
      <p class="collection-description">
        {{section.settings.section_desc}}
      </p>
    </div>
    <a href="/collections/all" class="view-all">View all →</a>
  </div>

  <div class="collection-grid">

    <!-- Product 1 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600"
          alt="Classic wristwatch"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">TIMELESS</p>
        <h3>Classic Minimal Watch</h3>
        <div class="product-price">
          <span class="current-price">$89.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

    <!-- Product 2 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600"
          alt="Red sports sneaker"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">ACTIVEWEAR</p>
        <h3>Everyday Sneakers</h3>
        <div class="product-price">
          <span class="current-price">$75.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

    <!-- Product 3 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=600"
          alt="Stylish leather handbag"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">ESSENTIALS</p>
        <h3>Everyday Leather Bag</h3>
        <div class="product-price">
          <span class="current-price">$95.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

    <!-- Product 4 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600"
          alt="Vintage film camera"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">CREATIVE GEAR</p>
        <h3>Vintage Film Camera</h3>
        <div class="product-price">
          <span class="current-price">$110.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

  </div>
</section>


{{ 'fetured-collection.css' | asset_url | stylesheet_tag }}


{% schema  %} 
{
   "name": "Featured Collection",
   "settings": [
    {
        "type": "text",
        "id": "section_title",
        "label": "Section Title",
        "default": "Featured Collection"
    },
     {
        "type": "text",
        "id": "section_label",
        "label": "Section Label",
        "default": "OUR FAVORITES"
    },
     {
        "type": "text",
        "id": "section_desc",
        "label": "Section Description",
        "default": " Discover our most-loved styles, picked just for you."
    }
   ],
   "blocks": [],
   "presets": [
    {
        "name": "Featured Collection"
    }
   ]
}
{% endschema %}