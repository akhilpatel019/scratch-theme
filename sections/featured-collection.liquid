<section class="featured-collection">
  <div class="collection-header">
    <div>
      <p class="collection-subtitle">OUR FAVORITES</p>
      <h2>Featured Collection</h2>
      <p class="collection-description">
        Discover our most-loved styles, picked just for you.
      </p>
    </div>
    <a href="/collections/all" class="view-all">View all →</a>
  </div>

  <div class="collection-grid">

    <!-- Product 1 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600"
          alt="Classic wristwatch"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">TIMELESS</p>
        <h3>Classic Minimal Watch</h3>
        <div class="product-price">
          <span class="current-price">$89.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

    <!-- Product 2 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600"
          alt="Red sports sneaker"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">ACTIVEWEAR</p>
        <h3>Everyday Sneakers</h3>
        <div class="product-price">
          <span class="current-price">$75.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

    <!-- Product 3 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=600"
          alt="Stylish leather handbag"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">ESSENTIALS</p>
        <h3>Everyday Leather Bag</h3>
        <div class="product-price">
          <span class="current-price">$95.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

    <!-- Product 4 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600"
          alt="Vintage film camera"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">CREATIVE GEAR</p>
        <h3>Vintage Film Camera</h3>
        <div class="product-price">
          <span class="current-price">$110.00</span>
        </div>
        <a href="/cart" class="add-to-cart">Add to Cart</a>
      </div>
    </div>

  </div>
</section>

<style>
  .featured-collection {
    padding: 60px 5%;
    background: #fff;
    color: #222;
    font-family: Arial, sans-serif;
  }

  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 32px;
  }

  .collection-subtitle {
    color: #777;
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .collection-header h2 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 10px;
  }

  .collection-description {
    color: #777;
    margin: 0;
    line-height: 1.6;
  }

  .view-all {
    color: #222;
    text-decoration: none;
    border-bottom: 1px solid #222;
    padding-bottom: 5px;
    white-space: nowrap;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .product-card {
    min-width: 0;
  }

  .product-image {
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: 4 / 5;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  .product-info {
    padding-top: 16px;
  }

  .product-vendor {
    color: #888;
    font-size: 11px;
    letter-spacing: 1.5px;
    margin: 0 0 8px;
  }

  .product-info h3 {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 10px;
  }

  .product-price {
    margin-bottom: 16px;
  }

  .current-price {
    font-weight: 600;
  }

  .add-to-cart {
    display: block;
    text-align: center;
    text-decoration: none;
    background: #222;
    color: #fff;
    padding: 12px;
    border: 1px solid #222;
    transition: background 0.2s, color 0.2s;
  }

  .add-to-cart:hover {
    background: #fff;
    color: #222;
  }

  @media (max-width: 900px) {
    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
  }

  @media (max-width: 480px) {
    .featured-collection {
      padding: 40px 16px;
    }

    .collection-header {
      align-items: flex-start;
    }

    .collection-description {
      font-size: 14px;
    }

    .view-all {
      font-size: 13px;
    }
  }
</style>



