<section class="featured-collection page_width">


  <div class="collection-header">
    <div>
      <p class="collection-subtitle">{{section.settings.section_label}}</p>
      <h2>{{section.settings.section_title}}</h2>
      <p class="collection-description">
        {{section.settings.section_desc}}
      </p>
    </div>
    <a href="/collections/all" class="view-all">View all →</a>
  </div>

  <div class="collection-grid">



      {% for collection_product in section.settings.featured_collection.products limit: section.settings.product_limit %}


    <!-- Product 1 -->
    <div class="product-card">
      <div class="product-image">
        <img
          src="{{collection_product.featured_image |  image_url: width: 300}}"
          alt="{{collection_product.title}}"
        >
      </div>
      <div class="product-info">
        <p class="product-vendor">{{collection_product.vendor}}</p>
        <h3>{{collection_product.title}}</h3>
        <div class="product-price">
          <span class="current-price">{{collection_product.price |  money}}</span>
        </div>
        <a href="{{collection_product.url}}" class="add-to-cart">See Options</a>
      </div>
    </div>

   {%endfor%}

  </div>
</section>


{{ 'fetured-collection.css' | asset_url | stylesheet_tag }}


{% schema  %} 
{
   "name": "Featured Collection",
   "settings": [
    {
        "type": "text",
        "id": "section_title",
        "label": "Section Title",
        "default": "Featured Collection"
    },
     {
        "type": "text",
        "id": "section_label",
        "label": "Section Label",
        "default": "OUR FAVORITES"
    },
     {
        "type": "text",
        "id": "section_desc",
        "label": "Section Description",
        "default": " Discover our most-loved styles, picked just for you."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select Collection"
    },
   {
  "type": "number",
  "id": "product_limit",
  "label": "Set Limit of Products",
  "default": 4
}
   ],
   "blocks": [],
   "presets": [
    {
        "name": "Featured Collection"
    }
   ]
}
{% endschema %}